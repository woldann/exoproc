# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
.nyc_output
*.lcov

# Build outputs
**/dist/
dist-tests/
**/deps/
build/
**/target/
*.tsbuildinfo
*.class
*.jar
# Per-package LICENSE copies (generated by scripts/build.ts at build time)
packages/*/LICENSE
# Bundled example client UIs + shared stylesheet (generated by
# scripts/build.ts at build time)
examples/*/client.js
examples/*/client.js.map
examples/kit/styles.generated.css
examples/kit/styles.generated.css.map
# Inspection artifacts (generated by `bun run inspect` in packages/simulate,
# see packages/simulate/artifacts/README.md) -- not part of the runtime
# build or the published npm package, shouldn't be committed.
packages/simulate/artifacts/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local
# tests/.env is committed on purpose -- non-secret test defaults
# (EXOPROC_LOG_LEVEL/EXOPROC_LOG_DIR) that tests/setup.ts expects to exist.
!tests/.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Linting
.eslintcache

# Dumps
dump/
packages/*/dump/

# Test artifacts
crt-*.bin
crt-*.txt
packages/*/crt-*.bin
packages/*/crt-*.txt

# Worktree backup
.git.worktree.bak

# Mappings and crawl outputs
*crawled-mappings*.json
live-crawled-mappings.json
mappings-*.json
packages/exoproc-tool/live-crawled-mappings.json
packages/minecraft/src/mappings/mappings-1.8.9.json


# Daemon standalone binaries/bundles and tool scratch output
packages/exoproc-daemon/standalone/
packages/exoproc-tool/tmp/
scratch/
