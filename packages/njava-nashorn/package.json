{
  "name": "@woldann/exoproc-nashorn",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.4.0",
  "description": "Pure TypeScript Nashorn runtime shims, template generators, and script simulator for the Exoproc / NJava ecosystem.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "exoproc",
    "njava",
    "nashorn",
    "simulator",
    "template",
    "shims"
  ],
  "author": "Serkan",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "bun test"
  },
  "devDependencies": {
    "@woldann/exoproc-mappings": "workspace:*",
    "typescript": "^5.8.2"
  }
}
