{
  "name": "exoproc-tool",
  "version": "0.1.0",
  "description": "Minecraft instrumentation and automation CLI tools",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "inspect-gui": "bun run src/commands/inspect-gui.tsx",
    "inspect-player": "bun run src/commands/inspect-player.ts",
    "inspect-world": "bun run src/commands/inspect-world.ts",
    "screenshot": "bun run src/commands/screenshot.tsx",
    "status": "bun run src/commands/status.tsx",
    "attach": "bun run src/commands/attach.ts",
    "detach": "bun run src/commands/detach.ts",
    "procs": "bun run src/commands/procs.tsx",
    "shutdown": "bun run src/commands/shutdown.ts",
    "eval": "bun run src/commands/eval.ts",
    "run": "bun run src/commands/run-script.ts",
