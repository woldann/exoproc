{
  "name": "@woldann/exoproc-minecraft",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.4.0",
  "description": "High-level Minecraft runtime inspection, dynamic obfuscation matching, and reflection client for Bun using bun-njava.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@woldann/exoproc-mappings": "workspace:*",
    "@woldann/bun-njava": "workspace:*",
    "@woldann/bun-xffi": "workspace:*"
  },
  "optionalDependencies": {
    "@woldann/bun-njava": "workspace:*",
    "@woldann/bun-xffi": "workspace:*",
    "@woldann/exoproc-accessors": "workspace:*"
  }
}
