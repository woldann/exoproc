{
  "name": "@woldann/exoproc",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.3.1",
  "description": "Modular external Minecraft automation client, CLI runner, MCP server, and runtime instrumentation framework for Bun using exoproc.",
  "main": "./dist/index.js",
  "bin": {
    "exoproc": "./dist/cli.js",
    "exoproc-daemon": "./dist/daemon/cli.js",
    "inspect-jar": "./dist/remote/inspect-jar.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inspect-jar": {
      "types": "./dist/remote/inspect-jar.d.ts",
      "import": "./dist/remote/inspect-jar.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js"
    },
    "./daemon/cli": {
      "types": "./dist/daemon/cli.d.ts",
      "import": "./dist/daemon/cli.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./asm": {
      "types": "./dist/asm.d.ts",
      "import": "./dist/asm.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "exoproc",
    "minecraft",
    "automation",
    "mcp",
    "daemon",
    "cli"
  ],
  "author": "Serkan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woldann/exoproc.git"
  },
  "homepage": "https://github.com/woldann/exoproc#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "terminal-image": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
