{
  "name": "exoproc",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Modular external Minecraft automation client, CLI runner, MCP server, and runtime instrumentation framework for Bun using exoproc.",
  "main": "./dist/index.js",
  "bin": {
    "exoproc": "./dist/cli.js",
    "exoproc-daemon": "./dist/daemon/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js"
    },
    "./daemon/cli": {
      "types": "./dist/daemon/cli.d.ts",
      "import": "./dist/daemon/cli.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./asm": {
      "types": "./dist/asm.d.ts",
      "import": "./dist/asm.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.3.11"
  },
  "cpu": [
    "x64"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "exoproc",
    "neptune",
    "minecraft",
    "automation",
    "mcp",
    "dashboard",
    "web-ui"
  ],
  "author": "Serkan",
  "homepage": "https://github.com/woldann/exoproc#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bun-capstone": "workspace:*",
    "bun-minhook": "workspace:*",
    "bun-nhook": "workspace:*",
    "bun-njava": "workspace:*",
    "bun-nshm": "workspace:*",
    "bun-nthread": "workspace:*",
    "bun-winapi": "workspace:*",
    "bun-xffi": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "exoproc-accessors": "workspace:*",
    "exoproc-asm": "workspace:*",
    "exoproc-jjit": "workspace:*",
    "exoproc-mappings": "workspace:*",
    "exoproc-minecraft": "workspace:*",
    "exoproc-utils": "workspace:*",
    "ink": "^7.1.1",
    "njava-agent": "workspace:*",
    "react": "^19.2.8",
    "terminal-image": "^5.0.1",
    "zod": "^3.24.1"
  }
}
