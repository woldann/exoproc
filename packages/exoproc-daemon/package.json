{
  "name": "exoproc-daemon",
  "version": "0.1.0",
  "description": "Standalone background instrumentation daemon for Minecraft and Windows x64 processes",
  "main": "./src/index.ts",
  "type": "module",
  "bin": {
    "exoproc-daemon": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "dependencies": {
    "bun-winapi": "workspace:*",
    "bun-xffi": "workspace:*",
    "bun-nthread": "workspace:*",
    "bun-njava": "workspace:*",
    "exoproc-accessors": "workspace:*",
    "exoproc-minecraft": "workspace:*",
    "exoproc": "workspace:*",
    "chalk": "^5.3.0"
  }
}
