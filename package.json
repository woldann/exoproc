{
  "name": "exoproc-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "TypeScript toolkit for Windows x64 native systems programming, memory manipulation, and process instrumentation.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples"
  ],
  "keywords": [
    "exoproc",
    "monorepo",
    "windows",
    "x64",
    "native",
    "systems-programming",
    "instrumentation",
    "assembler",
    "disassembler",
    "memory-manipulation"
  ],
  "author": "Serkan",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woldann/exoproc.git"
  },
  "bugs": {
    "url": "https://github.com/woldann/exoproc/issues"
  },
  "homepage": "https://github.com/woldann/exoproc#readme",
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.4.3",
  "bin": {
    "bun-wine": "./bun-wine"
  },
  "scripts": {
    "server:dev": "bun run scripts/dev-server.ts",
    "build": "bun run scripts/build.ts",
    "agent:build": "bun -e \"import { getAgentJarSync } from '@woldann/njava-agent'; getAgentJarSync({ force: true });\"",
    "tool:inspect-jar": "bun run packages/exoproc/src/remote/inspect-jar.ts",
    "tool:build": "bun run --cwd packages/exoproc build",
    "tool:cli": "bun run --cwd packages/exoproc dist/cli.js",
    "tool:agent-dump": "bun run --cwd packages/exoproc dist/cli.js agent:dump",
    "tool:status": "bun run --cwd packages/exoproc dist/cli.js status",
    "tool:procs": "bun run --cwd packages/exoproc dist/cli.js procs",
    "tool:attach": "bun run --cwd packages/exoproc dist/cli.js attach",
    "tool:upgrade": "bun run --cwd packages/exoproc dist/cli.js upgrade",
    "tool:upgrade-agent": "bun run --cwd packages/exoproc dist/cli.js upgrade-agent",
    "tool:detach": "bun run --cwd packages/exoproc dist/cli.js detach",
    "tool:player": "bun run --cwd packages/exoproc dist/cli.js player",
    "tool:world": "bun run --cwd packages/exoproc dist/cli.js world",
    "tool:gui": "bun run --cwd packages/exoproc dist/cli.js gui",
    "tool:state": "bun run --cwd packages/exoproc dist/cli.js state",
    "tool:target": "bun run --cwd packages/exoproc dist/cli.js target",
    "tool:entities": "bun run --cwd packages/exoproc dist/cli.js entities",
    "tool:inventory": "bun run --cwd packages/exoproc dist/cli.js inventory",
    "tool:java": "bun run --cwd packages/exoproc dist/cli.js java",
    "tool:chat": "bun run --cwd packages/exoproc dist/cli.js chat",
    "tool:look": "bun run --cwd packages/exoproc dist/cli.js look",
    "tool:action": "bun run --cwd packages/exoproc dist/cli.js action",
    "tool:jump": "bun run --cwd packages/exoproc dist/cli.js jump",
    "tool:attack": "bun run --cwd packages/exoproc dist/cli.js attack",
    "tool:use": "bun run --cwd packages/exoproc dist/cli.js use",
    "tool:slot": "bun run --cwd packages/exoproc dist/cli.js slot",
    "tool:click": "bun run --cwd packages/exoproc dist/cli.js click",
    "tool:close-screen": "bun run --cwd packages/exoproc dist/cli.js close-screen",
    "tool:resume": "bun run --cwd packages/exoproc dist/cli.js resume",
    "tool:navigate": "bun run --cwd packages/exoproc dist/cli.js navigate",
    "tool:crawl": "bun run --cwd packages/exoproc dist/cli.js crawl",
    "tool:export-mappings": "bun run --cwd packages/exoproc dist/cli.js export-mappings",
    "tool:eval": "bun run --cwd packages/exoproc dist/cli.js eval",
    "tool:run": "bun run --cwd packages/exoproc dist/cli.js run",
    "tool:screenshot": "bun run --cwd packages/exoproc dist/cli.js screenshot",
    "tool:pool": "bun run --cwd packages/exoproc dist/cli.js pool",
    "tool:database": "bun run --cwd packages/exoproc dist/cli.js database",
    "tool:serve": "bun run --cwd packages/exoproc dist/cli.js serve",
    "tool:mcp": "bun run --cwd packages/exoproc dist/mcp.js",
    "tool:shutdown": "bun run --cwd packages/exoproc dist/cli.js shutdown",
    "exoproc": "bun run packages/exoproc/dist/cli.js",
    "exoproc:cli": "bun run packages/exoproc/dist/cli.js",
    "web": "bun run --cwd apps/docs dev",
    "web:build": "bun run --cwd apps/docs build",
    "web:start": "bun run --cwd apps/docs start",
    "matcher:test": "./bun-wine scripts/test-auto-matcher.ts",
    "test:matcher": "./bun-wine test dist-tests/exoproc/matcher.test.js",
    "docs:dev": "npm run dev --workspace=docs --",
    "docs:build": "npm run build --workspace=docs --",
    "docs:preview": "npm run start --workspace=docs --",
    "simul": "npm run dev --workspace=@woldann/simulate --",
    "simulate": "npm run dev --workspace=@woldann/simulate --",
    "simulate:exec": "npm run exec --workspace=@woldann/simulate --",
    "simulate:inspect": "npm run inspect --workspace=@woldann/simulate",
    "simulate:inspect:nasm": "npm run inspect:nasm --workspace=@woldann/simulate",
    "simulate:build": "npm run build --workspace=@woldann/simulate",
    "simulate:test": "npm run test --workspace=@woldann/simulate",
    "simulate:test:node": "npm run test:node --workspace=@woldann/simulate",
    "tests:build": "npm exec --prefix packages/simulate -- tsx scripts/build-tests.ts",
    "build:clean": "bun run clean && bun run build",
    "clean": "find . -name dist -type d -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; rm -rf dist-tests; find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete 2>/dev/null; true",
    "download-deps": "bun scripts/download-deps.ts",
    "test": "npm run simulate:test:node",
    "test:bun": "bun test dist-tests/",
    "test:wine": "./bun-wine test dist-tests/",
    "test:watch": "bun test dist-tests/ --watch",
    "test:coverage": "bun test dist-tests/ --coverage",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" --cache",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" --cache --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "bun run build && bun x tsc --noEmit -p tests/tsconfig.json",
    "prepare": "husky",
    "postinstall": "bun run download-deps",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^8.57.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^14.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react-devtools-core": "^8.0.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^7.0.2",
    "unzipper": "^0.12.3",
    "winston": "^3.19.0"
  },
  "overrides": {
    "mdast-util-to-markdown": "2.1.2"
  }
}
